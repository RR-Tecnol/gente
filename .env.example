APP_NAME="GENTE"
APP_DESCRICAO="Gestão de Pessoas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# producao | desenv | homolog
AMBIENTE=desenv

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PII / LGPD — blind index (HMAC) separado de APP_KEY; após migrate, rode: php artisan gente:secure-pii
GENTE_PII_BLIND_SALT=
# Após gente:secure-pii --fle em homolog, ativar true (CPF cifrado em PESSOA_CPF_NUMERO)
GENTE_PII_CPF_ENCRYPTED=false
# true = oculta CPF no toArray/JSON (APIs de confiança: makeVisible)
GENTE_PII_MODEL_HIDE_CPF=false

# Frente 2: HMAC (X-Gente-Signature + X-Gente-Timestamp); corpo = raw JSON; janela ±GENTE_REQUEST_SIGNATURE_LEEWAY_MS
GENTE_REQUEST_SIGNATURE_ENABLED=false
GENTE_REQUEST_SIGNATURE_LEEWAY_MS=30000

# Frente 3: honeytokens (iscas) + canário; blocklist opcional
GENTE_HONEYTOKENS_ENABLED=true
GENTE_HONEY_BLOCKLIST_ENFORCE=true
GENTE_HONEY_BLOCKLIST_CANARY_24H=true
# Se true, bloqueia IP 24h também ao tocar em FUNCIONARIO isca (pode ser agressivo em homolog)
GENTE_HONEY_BLOCKLIST_ON_TOUCH=false

# ── Fase 3C — Manta de Proteção (tenant scope / rollout híbrido) ─────────────────
# Local/CI: mantenha MIDDLEWARE=false até precisar de logs. Homolog / Semana 1 (Shadow Total):
#   GENTE_TENANT_SCOPE_MIDDLEWARE=true
#   GENTE_TENANT_SCOPE_ENFORCE=false
#   GENTE_TENANT_SCOPE_LOG_CHANNEL=tenant_scope
# Semana 2+: enforce só na camada operacional (escalas/frequência/ponto) quando os logs estiverem limpos.
GENTE_TENANT_SCOPE_MIDDLEWARE=false
GENTE_TENANT_SCOPE_ENFORCE=false
GENTE_TENANT_SCOPE_LOG_CHANNEL=tenant_scope

# Fase 9A — Painel executivo (GET /api/v3/dashboard/operacional): cache e unidades MDE (siglas UNIDADE, ex. SEMED).
# GENTE_EXEC_DASHBOARD_CACHE_TTL=90
# GENTE_EXEC_DASHBOARD_MDE_SIGLAS=SEMED
# GENTE_EXEC_DASHBOARD_MOCK_FURO=false
# GENTE_EXEC_DASHBOARD_MOCK_FURO_VALOR=0

# Fase 8A — importação SISFOLHA (staging + promoção). Quarentena: MIG-NAO-CLASS / setor “A CLASSIFICAR”.
# GENTE_QUARENTENA_SETOR_ID=
# GENTE_QUARENTENA_UNIDADE_SIGLA=MIG-NAO-CLASS
# GENTE_QUARENTENA_SETOR_NOME=A CLASSIFICAR (import)
# GENTE_SISFOLHA_IMPORT_CHUNK=250
# GENTE_SISFOLHA_IMPORT_OPERATOR_ID=
# GENTE_SISFOLHA_IMPORT_DEFAULT_PASSWORD_HASH=
# Cabeçalho opcional no SPA para âncora de vínculo (acúmulo):
# GENTE_FUNCIONARIO_CONTEXT_HEADER=X-Gente-Funcionario-Context-Id
# Seed opt-in: utilizador auditor@semad.local (só papel auditoria_matriz_semad GLOBAL_SEMAD) — ver docs/davi/BUSINESS_RULES.md Fase 12.5
# GENTE_SEED_AUDITOR_SEMAD_STANDALONE=false

# Frontend RBAC gate: false = fallback legado quando slug ainda não veio no /me.
# Em homolog/prod, ativar true quando assignments RBAC estiverem carregados.
VITE_GENTE_RBAC_UI_STRICT=false

DB_CONNECTION=sqlsrv
# Host: 127.0.0.1 quando o Artisan roda no host e o SQL Server publica 1433 (docker-compose). Use sqlserver apenas dentro do container app na rede Docker.
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=gente
DB_USERNAME=sa
DB_PASSWORD=

# Timeout de login ODBC (segundos). Útil para falhar rápido em certificação/healthcheck.
DB_LOGIN_TIMEOUT=8

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@gente.rrtecnol.com.br"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# P5-Standby: integrações externas (false = desligado; plano)
P5_ESOCIAL_ENVIO=false
P5_CNAB_BANCARIO=false
P5_API_TERCEIRA_FOLHA=false
